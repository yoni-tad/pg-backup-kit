{
  "name": "pg-backup-kit",
  "version": "0.1.0",
  "description": "A reusable PostgreSQL backup, restore, verification, retention, and storage toolkit.",
  "main": "dist/index.js",
  "bin": {
    "pg-backup-kit": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "backup": "tsx src/index.ts backup",
    "restore": "tsx src/index.ts restore",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run tests/unit",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run tests/integration",
    "test:all": "npm test && npm run test:integration"
  },
 "keywords": [
    "postgresql",
    "postgres",
    "backup",
    "database",
    "database-backup",
    "restore",
    "s3",
    "supabase",
    "storage",
    "cli"
  ],
  "author": "Yoni Tad",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
